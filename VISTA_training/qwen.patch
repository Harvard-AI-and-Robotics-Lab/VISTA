+def retained_frame_tiles(frames, tile_size):
+    """Cover every original pixel with a regular grid; pad edges, never downsample."""
+    content, images = [], []
+    for index, frame in enumerate(frames):
+        h, w = frame.shape[:2]
+        for y in range(0, h, tile_size):
+            for x in range(0, w, tile_size):
+                crop = frame[y:y+tile_size, x:x+tile_size]
+                padded = np.zeros((tile_size, tile_size, 3), dtype=frame.dtype)
+                padded[:crop.shape[0], :crop.shape[1]] = crop
+                images.append(padded)
+                content.extend([
+                    {"type": "text", "text": f"Frame {index+1}, tile row {y//tile_size+1}, column {x//tile_size+1}:"},
+                    {"type": "image"},
+                ])
     return content, images
 
 
