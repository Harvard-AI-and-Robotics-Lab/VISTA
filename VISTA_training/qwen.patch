+"""Use PyTorch's causal SDPA kernels without quadratic masks for padded batches."""
+import torch
+import torch.nn.functional as F
+from transformers import AttentionInterface
+from transformers.masking_utils import AttentionMaskInterface, flash_attention_mask
+from transformers.integrations.sdpa_attention import sdpa_attention_forward
+
+
+def padded_sdpa(module, query, key, value, attention_mask, dropout=0.0, scaling=None, is_causal=None, **kwargs):
+    if attention_mask is None or attention_mask.ndim != 2:
+        return sdpa_attention_forward(module,query,key,value,attention_mask,dropout,scaling,is_causal,**kwargs)
+    outputs=[]
+    qlen,klen=query.shape[-2],key.shape[-2]
+    if qlen != klen and qlen != 1:
+        raise ValueError('Only full-sequence training or single-token cached decode supported')
+    for b in range(query.shape[0]):
+        keep=torch.nonzero(attention_mask[b,:klen],as_tuple=False).flatten()
+        qkeep=torch.nonzero(attention_mask[b,-qlen:],as_tuple=False).flatten()
+        q=query[b:b+1].index_select(2,qkeep)
+        k=key[b:b+1].index_select(2,keep)
+        v=value[b:b+1].index_select(2,keep)
+        out,_=sdpa_attention_forward(module,q,k,v,None,dropout,scaling,qlen>1,**kwargs)
+        padded=out.new_zeros((1,qlen,out.shape[2],out.shape[3])).index_copy(1,qkeep,out)
+        outputs.append(padded)
+    return torch.cat(outputs,dim=0),None
+
+
+def enable_padded_sdpa(model):
+    # Gemma's image-prefix and sliding-window masks require its native implementation.
+    if model.config.model_type not in ('internvl','qwen3_vl'):
+        return
+    AttentionInterface.register('vista_padded_sdpa',padded_sdpa)
+    AttentionMaskInterface.register('vista_padded_sdpa',flash_attention_mask)
+    model.model.language_model.config._attn_implementation='vista_padded_sdpa'
