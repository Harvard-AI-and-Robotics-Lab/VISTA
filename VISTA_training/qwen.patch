+def linear_patch_projection(module, hidden_states):
+    # Each input is already one complete non-overlapping Conv3d patch.
+    # The one-output-cell convolution is exactly the same affine map as GEMM.
+    # Avoid cuDNN's pathological large-batch tiny-volume Conv3d path.
+    weight = module.proj.weight
+    return F.linear(hidden_states.reshape(-1, weight[0].numel()).to(weight.dtype),
+                    weight.flatten(1), module.proj.bias)
+
 
 
